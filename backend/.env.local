# ═════════════════════════════════════════════════════════════════
# GroupHub Backend Configuration (.env.example)
# 
# Copy this file to .env and fill in the values for your environment
# NEVER commit .env to version control!
# ═════════════════════════════════════════════════════════════════

# SECURITY: REQUIRED in Production
# Generate a strong secret key using: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-here-change-in-production

# Token expiration time in minutes (default: 60 = 1 hour)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database URL
# SQLite (development): sqlite:///./grouphub.db
# PostgreSQL (production): postgresql://user:password@localhost/grouphub
DATABASE_URL=sqlite:///./grouphub.db

# CORS Origins (comma-separated URLs allowed to access this API)
# Development: http://localhost:3000
# Production: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=http://localhost:3000

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Redis configuration (optional, for rate limiting and caching)
# REDIS_URL=redis://localhost:6379
